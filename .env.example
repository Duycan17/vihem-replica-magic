# Neon Postgres — use the *pooled* connection string on Vercel (host contains "-pooler")
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Set the same variables in Vercel → Project → Settings → Environment Variables

# Cloudflare R2 (S3-compatible) for post images
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=your-bucket-name
R2_PUBLIC_BASE_URL=https://pub-xxx.r2.dev
VITE_R2_PUBLIC_BASE_URL=https://pub-xxx.r2.dev

# Canonical origin (no trailing path)
PUBLIC_SITE_URL=https://www.example.com
