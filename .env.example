# Neon Postgres (pooled connection string from Neon console)
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# CMS API auth (server-only; used by /api/cms/*)
CMS_AUTH_EMAIL=admin@example.com
CMS_AUTH_PASSWORD=change-me
CMS_SESSION_SECRET=generate-a-long-random-string
CMS_EDITOR_USER_ID=a0000000-0000-4000-8000-000000000001

# Cloudflare R2 (S3-compatible) for post images
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=your-bucket-name
R2_PUBLIC_BASE_URL=https://pub-xxx.r2.dev
VITE_R2_PUBLIC_BASE_URL=https://pub-xxx.r2.dev

# Canonical origin (no trailing path)
PUBLIC_SITE_URL=https://www.example.com
